rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidLicense(data) {
      return data.id is string &&
             data.clientName is string && data.clientName.size() <= 200 &&
             data.pcId is string && data.pcId.size() <= 200 &&
             data.validUntil is string &&
             data.status in ['active', 'revoked'];
    }

    function isValidTombstone(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.deletedAt is string && data.deletedAt.size() <= 64;
    }

    match /licenses/{licenseId} {
      allow read: if true; // Allows server and plugin validation verification
      allow create, update: if isValidId(licenseId) && isValidLicense(request.resource.data);
      allow delete: if isValidId(licenseId);
    }

    match /deleted_licenses/{tombstoneId} {
      allow read: if true;
      allow create, update: if isValidId(tombstoneId) && isValidTombstone(request.resource.data);
      allow delete: if isValidId(tombstoneId);
    }

    match /system_config/{configId} {
      allow read, write: if true;
    }
  }
}
